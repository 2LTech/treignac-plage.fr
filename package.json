{
  "name": "treignac-plage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "depcheck": "knip --dependencies",
    "prettier": "prettier -l '**/*.{js,jsx,ts,tsx,json,md,css}'",
    "lint": "eslint .",
    "dev": "next dev",
    "sitemap": "next-sitemap --config sitemap.config.mjs",
    "build": "yarn sitemap && next build",
    "start": "next start"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "knip": "6.35.1",
    "next-sitemap": "4.2.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.17.1"
}
